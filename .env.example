# Скопируйте в .env и заполните. Только плейсхолдеры — реальные значения не коммитить.
NODE_ENV=development
PORT=3000

# Публичный адрес сайта (используется в ссылках подписки и return_url оплаты)
PUBLIC_URL=http://localhost:3000

# postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/vpnhub
# true, если БД требует TLS (облачные Postgres)
DATABASE_SSL=false

# Случайная строка >= 32 символов: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME

# Название, которое Happ / v2RayTun покажут в профиле
BRAND_NAME=MyVPN
# Ссылка на поддержку (например, Telegram-бот), необязательно
SUPPORT_URL=

# ЮKassa (личный кабинет → Интеграция → Ключи API). Без них кнопки оплаты отключены.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
