# Скопируй этот файл в .env и заполни своими значениями.
# Файл .env НЕ попадает в git (см. .gitignore). Никому его не показывай.

# Токен бота от @BotFather
BOT_TOKEN=PUT_BOT_TOKEN_HERE

# Твой числовой Telegram ID (узнать у @userinfobot). Бот отвечает только ему.
OWNER_ID=PUT_YOUR_TELEGRAM_ID_HERE

# api_id и api_hash ОТДЕЛЬНОГО аккаунта с https://my.telegram.org -> API development tools
TG_API_ID=PUT_API_ID_HERE
TG_API_HASH=PUT_API_HASH_HERE

# Как часто опрашивать маркет, в секундах (минимум 1)
POLL_INTERVAL=2

# Шаблон прямой ссылки на лот в Portals. {id} — id лота.
# Формат не подтверждён официально — проверь на первом уведомлении.
PORTALS_LOT_LINK=https://t.me/portals/market?startapp=gift_{id}
