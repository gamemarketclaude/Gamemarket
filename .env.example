# Секрет для подписи cookie сессий. Обязателен в production — сгенерируйте
# случайную строку, например: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Без него в режиме разработки сервер сгенерирует временный секрет сам
# (тогда сессии не переживут перезапуск процесса).
SESSION_SECRET=

# Ключ для ИИ-модерации чата (контекстная проверка "номер по частям").
# Получить можно на https://console.anthropic.com/
# Без него сайт продолжит работать — просто вместо ИИ включится резервная
# эвристика (жёсткая проверка на 9+ цифр подряд).
ANTHROPIC_API_KEY=

# Необязательно: какую модель использовать для модерации (по умолчанию — Haiku, самая быстрая и дешёвая)
MODERATION_MODEL=claude-haiku-4-5-20251001

# production включает secure-cookies (требуют HTTPS) — задайте на реальном хостинге
NODE_ENV=development

PORT=3000

# Домен фронтенда, которому разрешён кросс-доменный доступ к этому API
# (CORS). Пусто/не задано = кросс-доменные запросы запрещены (безопасно по
# умолчанию, подходит для этого приложения — оно само отдаёт HTML). Задайте,
# только если добавите отдельный фронтенд на другом домене, который должен
# обращаться сюда через fetch/XHR, например: https://gearvault.example.com
ALLOWED_ORIGIN=

# Почты администраторов через запятую (например: you@mail.ru). После входа
# под такой почтой в шапке появится кнопка «Админка» — там бан/разбан по почте.
# Пусто = админки нет ни у кого (банить можно командой npm run ban).
ADMIN_EMAILS=
