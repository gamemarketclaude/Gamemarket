<a href="/product/<%= p.id %>" class="card card--<%= p.rarity %>">
  <div class="card__image">
    <% if (p.images && p.images.length) { %>
      <div class="gallery gallery--card" data-gallery>
        <div class="gallery__slides">
          <% p.images.forEach(function(file, i) { %>
            <img src="/public/uploads/products/<%= file %>" alt="<%= p.title %>" loading="lazy" class="gallery__slide <%= i === 0 ? 'is-active' : '' %>" data-gallery-slide>
          <% }) %>
        </div>
        <% if (p.images.length > 1) { %>
          <button type="button" class="gallery__arrow gallery__arrow--sm gallery__arrow--prev" data-gallery-prev aria-label="Предыдущее фото">‹</button>
          <button type="button" class="gallery__arrow gallery__arrow--sm gallery__arrow--next" data-gallery-next aria-label="Следующее фото">›</button>
          <div class="gallery__dots gallery__dots--sm" data-gallery-dots>
            <% p.images.forEach(function(file, i) { %>
              <button type="button" class="gallery__dot <%= i === 0 ? 'is-active' : '' %>" data-gallery-dot="<%= i %>" aria-label="Фото <%= i + 1 %>"></button>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <%- include('art', { seed: p.image_seed, rarity: p.rarity, icon: p.category_icon }) %>
    <% } %>
    <span class="card__rarity-tag card__rarity-tag--<%= p.rarity %>">
      <%= ({common:'Обычное', rare:'Редкое', epic:'Эпическое', legendary:'Легендарное'})[p.rarity] %>
    </span>
  </div>
  <div class="card__body">
    <span class="card__eyebrow"><%= p.game_name_ru %></span>
    <h3 class="card__title"><%= p.title %></h3>
    <% if (p.notable_items) { %>
      <p class="card__notable"><%= p.notable_items %></p>
    <% } %>
    <div class="card__seller">
      <span class="card__seller-name"><%= p.seller_name %></span>
      <span class="card__rating">★ <%= p.seller_rating %></span>
      <span class="card__deals"><%= p.seller_deals %> сделок</span>
    </div>
  </div>
  <div class="card__footer">
    <span class="card__stock"><%= p.stock %> шт. в наличии</span>
    <span class="card__price mono"><%= p.price %> ₽</span>
  </div>
</a>
